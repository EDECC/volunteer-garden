<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>iPad Entry Scanner</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://unpkg.com/html5-qrcode"></script>
</head>
<body class="bg-slate-900 text-white font-sans min-h-screen flex flex-col items-center justify-center p-4">

    <div class="w-full max-w-md text-center space-y-6">
        <div>
            <h1 class="text-2xl font-bold tracking-wide text-amber-400">Volunteer Sunflower Check-In</h1>
            <p class="text-slate-400 text-sm mt-1">Scan your invitation to add a sunflower to the main screen!</p>
        </div>

        <div class="bg-slate-800 p-4 rounded-2xl shadow-xl border border-slate-700 relative overflow-hidden">
            <div id="reader" class="rounded-xl overflow-hidden bg-slate-950"></div>
            
            <div id="success-overlay" class="absolute inset-0 bg-emerald-500 flex flex-col items-center justify-center space-y-2 opacity-0 pointer-events-none transition-opacity duration-300">
                <span class="text-6xl">🌻</span>
                <h2 class="text-2xl font-bold">Sunflower Sent!</h2>
                <p class="text-emerald-100 text-sm">Thank you for volunteering</p>
            </div>
        </div>

        <p class="text-xs text-slate-500">Device Status: <span class="text-emerald-400 fallback-active">Ready</span></p>
    </div>

    <script>
        // CRITICAL: Change 'my_secret_sunflower_garden_2026' to a unique word just for your event
        const TOPIC_NAME = 'my_secret_sunflower_garden_2026'; 
        let isThrottled = false;

        function onScanSuccess(decodedText, decodedResult) {
            if (isThrottled) return;
            isThrottled = true;

            // 1. Show success overlay immediately on iPad
            const overlay = document.getElementById('success-overlay');
            overlay.classList.remove('opacity-0');
            overlay.classList.add('opacity-100');

            // 2. Send signal to the main screen via ntfy.sh
            fetch(`https://ntfy.sh/${TOPIC_NAME}`, {
                method: 'POST',
                body: 'spawn_sunflower'
            })
            .catch(err => console.error("Error sending sunflower:", err));

            // 3. Reset scanner after 3 seconds for the next guest
            setTimeout(() => {
                overlay.classList.remove('opacity-100');
                overlay.classList.add('opacity-0');
                isThrottled = false;
            }, 3000);
        }

        // Initialize Scanner
        const html5QrcodeScanner = new Html5QrcodeScanner(
            "reader", { fps: 10, qrbox: { width: 260, height: 260 } }
        );
        html5QrcodeScanner.render(onScanSuccess);
    </script>
</body>
</html>
